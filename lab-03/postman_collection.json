          "port": "3000",
          "path": ["books"],
          "query": [
            { "key": "min_price", "value": "500" },
            { "key": "max_price", "value": "800" }
          ]
        },
        "description": "Filters books between ₹500 and ₹800 using SQL BETWEEN ? AND ?."
