          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books"],
          "query": [
            { "key": "order_by", "value": "price" },
            { "key": "order", "value": "DESC" },
            { "key": "limit", "value": "5" }
          ]
        },
        "description": "Sorts books by price descending with a limit of 5 records."
      },
      "response": []
