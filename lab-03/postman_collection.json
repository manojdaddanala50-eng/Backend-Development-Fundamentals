          "raw": "http://localhost:3000/books?search_q=Clean",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books"],
          "query": [
            { "key": "search_q", "value": "Clean" }
          ]
        },
        "description": "Searches books where title contains 'Clean' using SQL LIKE ? parameter."
      },
      "response": []
    },
    {
